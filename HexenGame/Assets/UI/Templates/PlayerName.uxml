<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; left: auto; top: auto; width: auto; min-height: 50px; background-color: rgba(255, 255, 255, 0.49); -unity-background-image-tint-color: rgb(255, 255, 255); position: relative;">
        <ui:Label tabindex="-1" text="Player Name" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 40px; width: 300px; background-color: rgba(255, 255, 255, 0);" />
        <ui:Label tabindex="-1" text="Captured Pieces:" parse-escape-sequences="true" display-tooltip-when-elided="true" style="font-size: 20px; -unity-text-align: upper-center;" />
    </ui:VisualElement>
</ui:UXML>
